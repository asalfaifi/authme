{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["image", "config", "runtimeSecret", "jwks", "service"],
  "properties": {
    "replicaCount": { "type": "integer", "minimum": 1 },
    "image": {
      "type": "object",
      "required": ["repository", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "config": {
      "type": "object",
      "required": ["publicUrl", "realms"],
      "properties": {
        "publicUrl": { "type": "string", "pattern": "^https://[^/]+(?::[0-9]+)?$" },
        "realms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" }
        },
        "trustProxy": { "type": "boolean" },
        "auditRetentionDays": { "type": "integer", "minimum": 1, "maximum": 3650 },
        "enableDynamicRegistration": { "type": "boolean" },
        "accessTokenTtlSeconds": { "type": "integer", "minimum": 60, "maximum": 3600 },
        "authorizationCodeTtlSeconds": { "type": "integer", "minimum": 30, "maximum": 300 },
        "sessionTtlSeconds": { "type": "integer", "minimum": 300, "maximum": 2592000 },
        "webauthnChallengeTtlSeconds": { "type": "integer", "minimum": 60, "maximum": 300 }
      }
    },
    "runtimeSecret": {
      "type": "object",
      "required": ["existingSecret", "databaseUrlKey"],
      "properties": {
        "existingSecret": { "type": "string", "minLength": 1 },
        "databaseUrlKey": { "type": "string", "minLength": 1 }
      }
    },
    "jwks": {
      "type": "object",
      "required": ["existingSecret", "mountPath"],
      "properties": {
        "existingSecret": { "type": "string", "minLength": 1 },
        "mountPath": { "type": "string", "pattern": "^/" }
      }
    },
    "service": {
      "type": "object",
      "required": ["type", "port"],
      "properties": {
        "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    }
  }
}
