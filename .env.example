# Copy this file to .env, replace every `replace-with-*` value, then run:
#   make keys
#   make compose-config
# Never commit the resulting .env or .local/jwks directory.

# Public endpoint. Use the exact externally visible HTTPS issuer URL in production.
AUTHME_PUBLIC_URL=https://auth.example.com
AUTHME_HOST_PORT=3000
AUTHME_BIND_ADDRESS=127.0.0.1
AUTHME_REALMS=master
AUTHME_TRUST_PROXY=true
AUTHME_LOG_LEVEL=info
AUTHME_AUDIT_RETENTION_DAYS=90

# PostgreSQL is mandatory. Keep this password URL-safe and use the same value in
# both POSTGRES_PASSWORD and DATABASE_URL.
POSTGRES_DB=authme
POSTGRES_USER=authme
POSTGRES_PASSWORD=replace-with-a-long-random-url-safe-password
DATABASE_URL=postgresql://authme:replace-with-a-long-random-url-safe-password@postgres:5432/authme

# Redis is optional. Leave empty when not using the Compose `cache` profile.
# When enabled locally, set REDIS_URL=redis://redis:6379/0.
REDIS_URL=

# Signing keys are generated locally with `make keys` and mounted read-only.
AUTHME_JWKS_HOST_DIR=./.local/jwks

# Static clients are grouped by realm. Prefer a secret-manager-rendered value in
# production; this empty master list is valid but cannot serve an application.
AUTHME_CLIENTS_JSON={"master":[]}

# Supply independent, cryptographically random values. Cookie keys are a
# comma-separated rotation set, newest first. Field encryption key must be a
# base64url-encoded 32-byte key.
AUTHME_COOKIE_KEYS=replace-with-random-64-hex-key-1,replace-with-random-64-hex-key-2
AUTHME_CSRF_SECRET=replace-with-a-random-64-hex-value
AUTHME_PASSWORD_PEPPER=replace-with-an-independent-random-64-hex-value
AUTHME_SUBJECT_SALT=replace-with-an-independent-random-64-hex-value
AUTHME_FIELD_ENCRYPTION_KEY=replace-with-a-base64url-encoded-32-byte-key
AUTHME_ADMIN_TOKEN=replace-with-an-independent-random-admin-bootstrap-token

# Dynamic client registration is off by default. When enabled, create short-lived
# initial access tokens through the protected administration API.
AUTHME_ENABLE_DYNAMIC_REGISTRATION=false

# Development bootstrap is deliberately disabled in the production container.
AUTHME_DEV_MODE=false
AUTHME_DEV_ADMIN_PASSWORD=
