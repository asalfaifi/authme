{
  "name": "authme",
  "version": "0.3.0",
  "description": "A standards-first, self-hosted identity and access server.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asalfaifi/authme.git"
  },
  "homepage": "https://github.com/asalfaifi/authme#readme",
  "bugs": {
    "url": "https://github.com/asalfaifi/authme/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "AUTHME_DEV_MODE=true node --watch src/index.js",
    "check": "node scripts/check-source.mjs",
    "test": "node --test --test-reporter=spec",
    "test:postgres": "node scripts/run-postgres-tests.mjs",
    "test:coverage": "node --test --experimental-test-coverage",
    "db:migrate": "node scripts/migrate.mjs",
    "keys:generate": "node scripts/generate-jwks.mjs",
    "bootstrap:user": "node scripts/bootstrap-user.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@node-saml/node-saml": "~5.1.0",
    "@simplewebauthn/server": "^13.3.2",
    "argon2": "^0.44.0",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jose": "^6.2.3",
    "ldapts": "^9.0.0",
    "oidc-provider": "~9.9.1",
    "otpauth": "^9.5.1",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "rate-limiter-flexible": "^11.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "supertest": "^7.2.2",
    "xml-crypto": "~6.1.2"
  }
}
